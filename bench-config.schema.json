        "parallel": {
          "default": true,
          "type": "boolean"
        },
        "outputDir": {
          "default": "./results",
          "type": "string"
        }
      },
      "required": [
        "runCount",
        "parallel",
        "outputDir"
      ],
      "additionalProperties": false
    },
    "variantDefaults": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "cmd": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "model": {
              "type": "string"
            },
            "model_params": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "costPerMillionTokens": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "setup": {
          "type": "object",
