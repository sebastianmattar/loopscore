{
    "name": "@sebastianmattar/loopscore",
    "author": {
        "name": "Sebastian Mattar",
        "email": "sebastian@mattar.xyz"
    },
    "version": "0.2.1",
    "description": "Benchmark agentic coding AIs against coding tasks",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "repository": {
        "url": "https://github.com/sebastianmattar/loopscore"
    },
    "homepage": "https://github.com/sebastianmattar/loopscore#readme",
    "bugs": {
        "url": "https://github.com/sebastianmattar/loopscore/issues"
    },
    "keywords": [
        "benchmark",
        "cli",
        "ai",
        "agents",
        "evaluation"
    ],
    "engines": {
        "node": ">=18"
    },
    "bin": {
        "loopscore": "dist/index.js"
    },
    "files": [
        "dist",
        "bench-config.schema.json",
        "benchmarks/*.config.yaml",
        ".github/skills",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rm -rf dist && genversion -e src/version.ts && tsc -p tsconfig.build.json && tsx scripts/generate-schema.ts",
        "dev": "tsx src/index.ts",
        "release": "changeset publish",
        "start": "node dist/index.js",
        "lint": "eslint src",
        "run:example": "pnpm run dev run benchmarks/caveman-skill.config.yaml",
        "changeset:changeset": "changeset",
        "changeset:version": "git push && changeset version",
        "changeset:release": "git tag v$(cat package.json | jq -r .version) && git push origin --follow-tags"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "cli-table3": "^0.6.5",
        "commander": "^14.0.3",
        "es-toolkit": "^1.46.1",
        "ora": "^9.4.0",
        "typescript": "^6.0.3",
        "yaml": "^2.8.4",
        "zod": "^4.4.2"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.6.0",
        "@changesets/cli": "^2.31.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.17",
        "eslint": "^10.3.0",
        "genversion": "^3.2.0",
        "globals": "^17.6.0",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.59.1",
        "zod-to-json-schema": "^3.25.2"
    }
}