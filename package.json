{
    "name": "loopscore",
    "version": "0.1.0",
    "description": "Benchmark agentic coding AIs against coding tasks",
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sebastianmattar/loopscore.git"
    },
    "homepage": "https://github.com/sebastianmattar/loopscore#readme",
    "bugs": {
        "url": "https://github.com/sebastianmattar/loopscore/issues"
    },
    "keywords": [
        "benchmark",
        "cli",
        "ai",
        "agents",
        "evaluation"
    ],
    "engines": {
        "node": ">=18"
    },
    "bin": {
        "loopscore": "./dist/index.js"
    },
    "files": [
        "dist",
        "bench-config.schema.json",
        "benchmarks/*.config.yaml",
        ".github/skills",
        "README.md"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json && tsx scripts/generate-schema.ts",
        "changeset": "changeset",
        "dev": "tsx src/index.ts",
        "prepack": "pnpm run build",
        "release": "changeset publish",
        "start": "node dist/index.js",
        "lint": "eslint src",
        "run:example": "pnpm run dev run benchmarks/caveman-skill.config.yaml",
        "version-packages": "changeset version"
    },
    "dependencies": {
        "chalk": "^4.1.2",
        "cli-table3": "^0.6.5",
        "commander": "^14.0.3",
        "es-toolkit": "^1.46.1",
        "ora": "^9.4.0",
        "typescript": "^6.0.3",
        "yaml": "^2.8.3",
        "zod": "^4.4.1"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.31.0",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.17",
        "eslint": "^10.2.1",
        "globals": "^17.5.0",
        "tsx": "^4.21.0",
        "typescript-eslint": "^8.59.1",
        "zod-to-json-schema": "^3.25.2"
    }
}